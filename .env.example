# ===========================================
# Project Athena - Environment Variables
# ===========================================

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Auth (Required) ---
# Set during setup wizard, stored in app_config table
# PASSPHRASE is configured via the UI, not env vars

# --- AI (Required) ---
# Anthropic API key - set during setup wizard or here
# ANTHROPIC_API_KEY=your-anthropic-key

# --- App URL (Required for Vercel cron) ---
# Set this to your production Vercel URL to enable cron-triggered reports
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Email Notifications (Optional) ---
# RESEND_API_KEY=your-resend-key
# NOTIFICATION_EMAIL=you@example.com

# --- WHOOP Integration (Optional) ---
# WHOOP_CLIENT_ID=your-whoop-client-id
# WHOOP_CLIENT_SECRET=your-whoop-client-secret

# --- Single User Mode ---
# The app runs in single-user mode. This ID is auto-generated on first setup.
# SINGLE_USER_ID=00000000-0000-0000-0000-000000000000
